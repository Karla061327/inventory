# ===========================================
# INVENTORY MANAGEMENT SYSTEM - Environment
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=inventory_db

# JWT Configuration
# IMPORTANT: Change this secret in production!
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-32-chars
JWT_EXPIRES_IN=1h

# Application Configuration
PORT=3000
NODE_ENV=development

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@inventory.com
PGADMIN_PASSWORD=admin123

# ===========================================
# Production Environment Notes:
# ===========================================
# 1. Change JWT_SECRET to a secure random string (min 32 chars)
# 2. Use strong passwords for DB_PASSWORD
# 3. Set NODE_ENV=production
# 4. Consider using environment-specific .env files:
#    - .env.development
#    - .env.staging
#    - .env.production
# ===========================================
